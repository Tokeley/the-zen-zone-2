# Supabase (required — scenes load from the database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase admin (required only for /admin uploads)
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (optional — map falls back to a demo token without this)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudflare R2 — public URLs for scene/texture media
NEXT_PUBLIC_R2_SCENES_URL=
NEXT_PUBLIC_R2_TEXTURES_URL=

# Cloudflare R2 — server-side upload credentials (admin only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_SCENES=
